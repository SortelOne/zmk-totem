//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/brightness.dtsi>  // Prospector &inc_bri / &dec_bri

// Layer numbers (written as plain numbers below so the keymap editor can read them).
// When two layers are active, the higher number wins.
//   0 Base
//   1 Mod     shared by the Ctrl and Cmd thumbs (via &lm)
//   2 Extras  left inner thumb (hold): left-hand edit keys + right-hand symbols
//   3 Nav     right middle thumb: arrows/paging + numpad
//   4 Fun     right outer thumb: media, brightness, F-keys
//   5 System  hold Extras + Nav together: Bluetooth, bootloader, macros

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        /**
         * Temporarily switches to a layer (`&mo`) while a modifier is held.
         * Analogous to QMK's `LM()`, using a parameterized macro.
         *
         * Params:
         *  1. Layer to switch to
         *  2. Modifier to press while layer is active
         *
         * Example:
         *  `&lm NUM_LAYER LSHIFT`
         */
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        system_layer {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp J &kp A &kp K &kp E &kp DOT &kp B &kp A &kp L &kp E &kp S &kp N7 &kp N2 &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL";
        };

        console_log: console_log {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp L &kp O &kp G &kp LPAR &kp SQT &kp K_PASTE &kp SQT &kp RPAR>;
            label = "CONSOLE_LOG";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //          Q      W      E      R      T          Y      U      I      O      P
        //          A      S      D      F      G          H      J      K      L      ;
        //  ⇧/TAB   Z      X      C      V      B          N      M      ,      .      /     ⌥/'
        //                     CTRL+  CMD+   EXTRAS/      SPACE  NAV    FUN
        //                     MOD    MOD    SPACE
        // ⇧/TAB = tap Tab, hold Shift.  ⌥/' = tap ', hold Option.  EXTRAS/SPACE = tap Space, hold Extras.
        Base {
            display-name = "Base";
            bindings = <
                    &kp Q  &kp W  &kp E                   &kp R                   &kp T                 &kp Y      &kp U       &kp I      &kp O    &kp P
                    &kp A  &kp S  &kp D                   &kp F                   &kp G                 &kp H      &kp J       &kp K      &kp L    &kp SEMICOLON
&hm LEFT_SHIFT TAB  &kp Z  &kp X  &kp C                   &kp V                   &kp B                 &kp N      &kp M       &kp COMMA  &kp DOT  &kp SLASH      &hm LEFT_ALT SQT
                                  &lm 1 LEFT_CONTROL    &lm 1 LEFT_COMMAND    &lt 2 SPACE      &kp SPACE  &mo 3     &mo 4
            >;
        };

        // Active while holding the Ctrl or Cmd thumb. Everything passes through,
        // except D and F also act as Shift when held (for Cmd+Shift+... combos).
        Mod {
            display-name = "Mod";
            bindings = <
        &trans  &trans  &trans            &trans            &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &hm LEFT_SHIFT D  &hm LEFT_SHIFT F  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans            &trans            &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans            &trans            &trans    &trans  &trans  &trans
            >;
        };

        //          ESC    ·      ·      ·      `          !      @      #      $      %
        //          ~      TAB    SPACE  BKSPC  ENTER      ^      (      )      {      }
        //  ·       CMD    ALT    SHIFT  DEL    ·          &      [      ]      -      =      \
        //                     ·      ·      [held]       ·      SYSTEM ·
        // Left hand = one-handed editing (mouse in right hand). Right hand = symbols, no Shift needed.
        Extras {
            display-name = "Extras";
            bindings = <
                &kp ESCAPE  &trans         &trans        &trans          &kp GRAVE        &kp EXCL   &kp AT    &kp HASH  &kp DOLLAR  &kp PERCENT
                &kp TILDE   &kp TAB        &kp SPACE     &kp BACKSPACE   &kp ENTER        &kp CARET  &kp LPAR  &kp RPAR  &kp LBRC    &kp RBRC
&trans          &kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp DELETE  &trans           &kp AMPS   &kp LBKT  &kp RBKT  &kp MINUS   &kp EQUAL    &kp BACKSLASH
                                           &trans        &trans          &trans           &trans     &trans    &trans
            >;
        };

        //          ·      HOME   ↑      END    PG UP      +      7      8      9      0
        //          ALT    ←      ↓      →      PG DN      -      4      5      6      *
        //  ·       ·      ·      ·      ·      ·          =      1      2      3      .      /
        //                     ·      ·      SYSTEM       ·      [held] ·
        // "·" passes through to Base, so Cmd+Z/X/C/V and Shift still work while on Nav.
        Nav {
            display-name = "Nav";
            bindings = <
        &trans        &kp HOME  &kp UP_ARROW  &kp END    &kp PAGE_UP      &kp PLUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
        &kp LEFT_ALT  &kp LEFT  &kp DOWN      &kp RIGHT  &kp PAGE_DOWN    &kp MINUS  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK
&trans  &trans        &trans    &trans        &trans     &trans           &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT       &kp SLASH
                                &trans        &trans     &trans           &trans     &trans        &trans
            >;
        };

        //          ·      ·      MAC-   MAC+   ·          ·      F7     F8     F9     F10
        //          ·      MUTE   PRO-   PRO+   ·          ·      F4     F5     F6     F11
        //  ·       PREV   NEXT   VOL-   VOL+   PLAY       ·      F1     F2     F3     F12    ·
        //                     ·      ·      ·            ·      ·      [held]
        // MAC = Mac display brightness, PRO = Prospector screen brightness.
        Fun {
            display-name = "Fun";
            bindings = <
        &trans  &trans        &kp C_BRI_DN  &kp C_BRI_UP  &trans              &trans  &kp F7  &kp F8  &kp F9  &kp F10
        &trans  &kp C_MUTE    &dec_bri      &inc_bri      &trans              &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &kp C_PREV    &kp C_NEXT    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PLAY_PAUSE    &trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                                    &trans        &trans        &trans              &trans  &trans  &trans
            >;
        };

        // Hold EXTRAS (left inner thumb) + NAV (right middle thumb).
        //          BT0    BT1    BT2    BT3    BT4        ·      C.LOG  ·      ·      ·
        //          USB    BLE    ·      ·      ·          ·      EMAIL  ·      ·      ·
        //  BOOT    ·      ·      ·      ·      BT CLR     ·      ·      ·      ·      STUDIO BOOT
        // BOOT reboots the half you press it on into bootloader mode. STUDIO = ZMK Studio unlock.
        System {
            display-name = "System";
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &console_log  &none  &none  &none
                &out OUT_USB  &out OUT_BLE  &none         &none         &none           &none  &email        &none  &none  &none
&bootloader     &none         &none         &none         &none         &bt BT_CLR      &none  &none         &none  &none  &studio_unlock  &bootloader
                                            &none         &none         &none           &none  &none         &none
            >;
        };
    };
};
